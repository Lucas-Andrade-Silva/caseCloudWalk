# Copie para .env se quiser trocar os padrões. O .env é ignorado pelo git.
# Valores de desenvolvimento local, com dados sintéticos. Nunca use em ambiente exposto.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev
API_PORT=3000

# Segredos de assinatura de webhook. Aceitam lista separada por vírgula (rotação):
# o receptor aceita todos, o emissor assina com o primeiro.
CHANNEL_WEBHOOK_SECRETS=dev-channel-secret
BROKER_WEBHOOK_SECRETS=dev-broker-secret

# Token do usuário bot (o agente de IA), usado pelo broker para chamar a API da plataforma.
BOT_API_TOKEN=dev-bot-token
